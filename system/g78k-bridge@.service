[Unit]
Description=GameSir G7 Pro 8K bridge (virtual Xbox Elite 2, USB %i)
Documentation=file:///usr/local/share/doc/g78k-bridge/README.md

[Service]
Type=exec
# "+" = run outside the sandbox below. These two are the only steps that write to /sys:
# hide the raw controller again if it had been given back, and give it back to games
# whenever the bridge stops for any reason (no-op if the controller was unplugged).
ExecStartPre=+/usr/local/bin/g78k-bridge --hide %i
ExecStart=/usr/local/bin/g78k-bridge --usb %i
ExecStopPost=+/usr/local/bin/g78k-bridge --restore %i
Restart=on-failure
RestartSec=1
# Slightly ahead of normal programs so input stays smooth while a game loads the CPU.
Nice=-10

# Hardening: the bridge itself only opens the controller's hidraw nodes, /dev/uinput
# (virtual Xbox Elite) or /dev/uhid (virtual DualSense Edge), and reads sysfs.
# To present a DualSense Edge instead, create a drop-in (sudo systemctl edit
# g78k-bridge@.service) containing, under [Service], an empty "ExecStart=" line followed by
# "ExecStart=/usr/local/bin/g78k-bridge --output dualsense-edge --usb %i".
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
DeviceAllow=/dev/uinput rw
DeviceAllow=char-hidraw rw
NoNewPrivileges=yes
UMask=0077
ProtectProc=invisible
ProcSubset=pid
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
